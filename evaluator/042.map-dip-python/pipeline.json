{
  "case_root": "../../.submit-output/chatgpt-api/cases/042.map-dip-python",
  "baseline_case_root": "../../cases/042.map-dip-python",
  "build_dir": "../../build",
  "modules": [
    {
      "module_name": "required_paths",
      "name": "case042_required_layout",
      "paths": ["src/map_snapshot.py", "src/providers_builtin.py", "app/main.py"]
    },
    {
      "module_name": "baseline_diff",
      "name": "case042_cli_stability_check",
      "paths": ["app/main.py"]
    },
    {
      "module_name": "unit_test",
      "name": "case042_map_snapshot_tests",
      "command": [
        "ctest", "--test-dir", "{build_dir}", "--output-on-failure",
        "-R", "^case042_map_snapshot_tests$"
      ]
    },
    {
      "module_name": "customized_check",
      "name": "case042_dependency_inversion_check",
      "command": [
        "python3", "{evaluator_root}/checks/run_evaluator.py",
        "--case_root", "{case_root}"
      ],
      "env": {"PYTHONPATH": "{repo_root}"}
    }
  ]
}
