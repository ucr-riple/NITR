{
  "case_root": "../../.submit-output/chatgpt-api/cases/032.metric-recorder-buffered-flush-python",
  "baseline_case_root": "../../cases/032.metric-recorder-buffered-flush-python",
  "build_dir": "../../build",
  "modules": [
    {
      "module_name": "required_paths",
      "name": "case032_required_layout",
      "paths": [
        "src/metric_recorder.py",
        "src/console_metric_recorder.py",
        "src/metric_collector.py",
        "app/main.py"
      ]
    },
    {
      "module_name": "unit_test",
      "name": "case032_recorder_lifecycle_tests",
      "command": [
        "ctest",
        "--test-dir",
        "{build_dir}",
        "--output-on-failure",
        "-R",
        "^case032_recorder_lifecycle_tests$"
      ]
    },
    {
      "module_name": "customized_check",
      "name": "case032_substitutability_check",
      "command": [
        "python3",
        "{evaluator_root}/checks/run_evaluator.py",
        "--case_root",
        "{case_root}"
      ],
      "env": {
        "PYTHONPATH": "{repo_root}"
      }
    }
  ]
}
