{
  "case_root": "../../.submit-output/chatgpt-api/cases/033.logging-side-effects-python",
  "baseline_case_root": "../../cases/033.logging-side-effects-python",
  "build_dir": "../../build",
  "modules": [
    {
      "module_name": "required_paths",
      "name": "case033_required_layout",
      "paths": [
        "src/applicant.py",
        "src/audit_logger.py",
        "src/loan_policy.py",
        "src/loan_review_service.py",
        "app/main.py"
      ]
    },
    {
      "module_name": "unit_test",
      "name": "case033_loan_review_tests",
      "command": [
        "ctest",
        "--test-dir",
        "{build_dir}",
        "--output-on-failure",
        "-R",
        "^case033_loan_review_tests$"
      ]
    },
    {
      "module_name": "customized_check",
      "name": "case033_side_effect_isolation_check",
      "command": [
        "python3",
        "{evaluator_root}/checks/run_evaluator.py",
        "--case_root",
        "{case_root}"
      ],
      "env": {
        "PYTHONPATH": "{repo_root}"
      }
    }
  ]
}
