{
  "case_root": "../../.submit-output/chatgpt-api/cases/041.ml-lsp-multistep-python",
  "baseline_case_root": "../../cases/041.ml-lsp-multistep-python",
  "build_dir": "../../build",
  "modules": [
    {
      "module_name": "required_paths",
      "name": "case041_required_layout",
      "paths": [
        "src/feature_transform.py",
        "src/feature_pipeline.py",
        "src/clamp_transform.py",
        "src/transform_batch.py",
        "src/transform_chain.py"
      ]
    },
    {
      "module_name": "baseline_diff",
      "name": "case041_protected_files_check",
      "paths": ["src/feature_transform.py", "src/feature_pipeline.py"]
    },
    {
      "module_name": "unit_test",
      "name": "case041_transform_tests",
      "command": [
        "ctest", "--test-dir", "{build_dir}", "--output-on-failure",
        "-R", "^case041_transform_tests$"
      ]
    },
    {
      "module_name": "customized_check",
      "name": "case041_substitutability_check",
      "command": [
        "python3", "{evaluator_root}/checks/run_evaluator.py",
        "--case_root", "{case_root}"
      ],
      "env": {"PYTHONPATH": "{repo_root}"}
    }
  ]
}
